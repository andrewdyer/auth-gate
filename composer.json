{
    "name": "andrewdyer/gate",
    "description": "A framework-agnostic PHP library for defining and enforcing authorisation rules through a simple, expressive gate interface",
    "keywords": [
        "php",
        "gate",
        "authorization",
        "permissions"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrew Dyer",
            "homepage": "https://andrewdyer.rocks",
            "role": "developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "AndrewDyer\\Gate\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AndrewDyer\\Gate\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "cs": [
            "vendor/bin/php-cs-fixer fix"
        ]
    }
}
